<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Expose `fixed_price` on the product template attribute value form so
        the field can be edited from the dialog opened through the
        "Attributes & Variants" tab on the product template form.
    -->
    <record id="product_template_attribute_value_view_form_inherit" model="ir.ui.view">
        <field name="name">product.template.attribute.value.form.fixed.price</field>
        <field name="model">product.template.attribute.value</field>
        <field name="inherit_id" ref="product.product_template_attribute_value_view_form"/>
        <field name="arch" type="xml">
            <field name="price_extra" position="after">
                <field name="fixed_price"/>
            </field>
        </field>
    </record>

    <!--
        Show the computed fixed price total on the variant form so users can
        verify what was computed for each generated product.product. The
        fields are hidden when no fixed price is configured for the variant.
    -->
    <record id="product_normal_form_view_inherit_fixed_price" model="ir.ui.view">
        <field name="name">product.product.form.fixed.price</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <field name="lst_price" position="after">
                <field name="fixed_price_total"
                       invisible="not has_fixed_price"
                       readonly="1"/>
                <field name="has_fixed_price" invisible="1"/>
            </field>
        </field>
    </record>

    <!--
        On the product template form, make list_price (Sales Price)
        read-only when every variant of the template has a fixed price
        configured. The field is then auto-managed by
        _sync_list_price_from_variants on product.template.

        The helper field has_priced_variants is added to the form (invisible)
        so the readonly Python expression can resolve it.
    -->
    <record id="product_template_form_view_inherit_fixed_price" model="ir.ui.view">
        <field name="name">product.template.form.fixed.price.readonly</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='list_price']" position="attributes">
                <attribute name="readonly">has_priced_variants</attribute>
            </xpath>
            <xpath expr="//field[@name='list_price']" position="after">
                <field name="has_priced_variants" invisible="1"/>
            </xpath>
        </field>
    </record>

</odoo>
